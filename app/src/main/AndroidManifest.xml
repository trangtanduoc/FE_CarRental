<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.prm.carrental">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".core.CarRentalApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carrental"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.payment.PaymentSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payment.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.rental.RentalDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.rental.ActiveRentalActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.station.VehicleDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.station.StationDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.ReceiveVehicleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.VehicleManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StationVehiclesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.UserVerificationDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.PendingVerificationListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
