<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.prm.carrental">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".core.CarRentalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carrental"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.staff.StaffVehicleListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffStatusVehicleHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffStationDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffVehicleDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffStationListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payment.PaymentSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payment.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.rental.RentalDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.rental.ActiveRentalActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.station.VehicleDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.station.StationDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.ReceiveVehicleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.VehicleManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffStationVehicleListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffUserDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffUserListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.staff.StaffHomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>